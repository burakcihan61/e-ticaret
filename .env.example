# Database
# PostgreSQL connection string from Prisma Postgres
# Example: prisma+postgres://accelerate.prisma-data.net/?api_key=your_api_key
DATABASE_URL=

# Direct connection string for Prisma
DIRECT_URL=

# Authentication
# Secret key for JWT token encryption (use a strong random string)
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Site Configuration
# Base URL of your application (used for redirects, sitemap, robots.txt)
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Iyzico Payment Gateway
# Get your credentials from https://merchant.iyzipay.com/
# For testing, use sandbox credentials
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Node Environment
# Automatically set by Next.js, but can be overridden
# Options: development, production, test
NODE_ENV=development
